# ---- Auth ----
# `openssl rand -base64 32` or https://generate-secret.vercel.app/32
AUTH_SECRET=replace-with-random-32-byte-string
# For local dev, keep this. In production set to https://your-domain.com
AUTH_URL=http://localhost:3000

# ---- Google OAuth 2.0 ----
# https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client ID; web app)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# Enable Google Calendar API if you want calendar sync.
GOOGLE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret

# ---- Supabase (Postgres) ----
# https://supabase.com/dashboard  (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Service role key — server-only. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ---- Resend (email reminders) ----
# https://resend.com  (API Keys). Verify a sending domain before production.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="CampusFlow <reminders@your-domain.com>"

# ---- Cron auth ----
# Any random string. Vercel Cron sends `Authorization: Bearer $CRON_SECRET` when set.
CRON_SECRET=replace-with-random-string
